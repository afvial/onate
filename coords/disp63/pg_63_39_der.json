{"img_w": 1084, "img_h": 4017, "img_name": "facsimiles/disp63/pg_63_39_der.png", "lines": {"1": {"bbox": {"x": 12, "y": 3, "w": 1054, "h": 66}, "text": "vermis, quam gemma, & similiter, vsus"}, "2": {"bbox": {"x": 3, "y": 71, "w": 1058, "h": 74}, "text": "magis necessarios, & vtiles habentes,"}, "3": {"bbox": {"x": 12, "y": 138, "w": 1039, "h": 63}, "text": "quam quae non sunt necessariae, vel vti¬"}, "4": {"bbox": {"x": 11, "y": 210, "w": 1056, "h": 61}, "text": "les; vnde vnicus panis multis gemmis,"}, "5": {"bbox": {"x": 12, "y": 279, "w": 1047, "h": 50}, "text": "& falconibus esset praeponendus, & pre¬"}, "6": {"bbox": {"x": 7, "y": 345, "w": 1056, "h": 57}, "text": "tiosior, quod nemo sani capitis dixerit."}, "7": {"bbox": {"x": 74, "y": 411, "w": 1004, "h": 57}, "text": "Hanc vltimam opinionem, quae ferè"}, "8": {"bbox": {"x": 12, "y": 480, "w": 1051, "h": 57}, "text": "omnium est omninò veram existimo, &"}, "9": {"bbox": {"x": 7, "y": 546, "w": 1059, "h": 58}, "text": "in re morali sequendàm in praxi, quam"}, "10": {"bbox": {"x": 7, "y": 614, "w": 1060, "h": 68}, "text": "mihi non solum maior DD. authoritas,"}, "11": {"bbox": {"x": 11, "y": 682, "w": 1052, "h": 64}, "text": "sed etiam rationes eius, maximè tertia"}, "12": {"bbox": {"x": 3, "y": 750, "w": 1054, "h": 79}, "text": "suadent. Quibus addo rationem à prio¬"}, "13": {"bbox": {"x": 9, "y": 817, "w": 1054, "h": 62}, "text": "ri videri, quod licet iudicium illud sit"}, "14": {"bbox": {"x": 3, "y": 885, "w": 1043, "h": 53}, "text": "certum, ac definitum secundum ratio¬"}, "15": {"bbox": {"x": 5, "y": 955, "w": 1057, "h": 54}, "text": "nem, & secundum scientiam Dei, quae"}, "16": {"bbox": {"x": 9, "y": 1017, "w": 1048, "h": 63}, "text": "omnes circumstantias, & collationem"}, "17": {"bbox": {"x": 9, "y": 1082, "w": 1032, "h": 57}, "text": "earum inter se, & cum Deo comprehen¬"}, "18": {"bbox": {"x": 12, "y": 1153, "w": 1039, "h": 60}, "text": "dit: tamen aestimatio, & valor, de quo"}, "19": {"bbox": {"x": 1, "y": 1219, "w": 1054, "h": 61}, "text": "agimus, non dicit ordinem essentialem"}, "20": {"bbox": {"x": 3, "y": 1284, "w": 1052, "h": 65}, "text": "ad scientiam Dei, neque ad rationem"}, "21": {"bbox": {"x": 11, "y": 1352, "w": 1046, "h": 63}, "text": "obiectiuam rerum ipsarum à natura illis"}, "22": {"bbox": {"x": 17, "y": 1418, "w": 1046, "h": 71}, "text": "prouenientem, sed ad aestimationem, &"}, "23": {"bbox": {"x": 9, "y": 1486, "w": 1048, "h": 69}, "text": "iudicium humanum, quod varium est,"}, "24": {"bbox": {"x": 5, "y": 1553, "w": 1058, "h": 66}, "text": "& latitudinem habet. Neque interest"}, "25": {"bbox": {"x": 9, "y": 1628, "w": 1038, "h": 48}, "text": "vera ne sit, an falsa illa hominum, & vul¬"}, "26": {"bbox": {"x": 25, "y": 1688, "w": 1026, "h": 84}, "text": "gi opinio in aestimandis rebus vendibili¬"}, "27": {"bbox": {"x": 3, "y": 1750, "w": 1051, "h": 58}, "text": "bus; nam etiam quae falsa est verum pre¬"}, "28": {"bbox": {"x": 16, "y": 1816, "w": 1039, "h": 59}, "text": "tium, & iustum efficit. Accipe apposi¬"}, "29": {"bbox": {"x": 12, "y": 1885, "w": 1047, "h": 68}, "text": "tissimum exemplum in praescriptione,"}, "30": {"bbox": {"x": 13, "y": 1951, "w": 1050, "h": 55}, "text": "& vsucapione, nam vera, & iusta prae¬"}, "31": {"bbox": {"x": 16, "y": 2023, "w": 1047, "h": 57}, "text": "scriptio, & vsucapio est, non solum coran"}, "32": {"bbox": {"x": 13, "y": 2082, "w": 1048, "h": 60}, "text": "hominibus, sed etiam coram Deo, quae"}, "33": {"bbox": {"x": 11, "y": 2153, "w": 1044, "h": 57}, "text": "in falsa, sed inuincibili rei propriae opi¬"}, "34": {"bbox": {"x": 11, "y": 2211, "w": 1034, "h": 64}, "text": "nione, & fide bona, sed falsa fundatur."}, "35": {"bbox": {"x": 12, "y": 2277, "w": 1051, "h": 70}, "text": "Licet enim Deus videat illum falli, etiam"}, "36": {"bbox": {"x": 16, "y": 2347, "w": 1045, "h": 74}, "text": "ipse Deus iudicat, & probat verè prae¬"}, "37": {"bbox": {"x": 11, "y": 2414, "w": 1050, "h": 67}, "text": "scribere. Et iudicem, qui secundum"}, "38": {"bbox": {"x": 5, "y": 2480, "w": 1058, "h": 59}, "text": "allegata sontem absoluit, iudicat Deus"}, "39": {"bbox": {"x": 11, "y": 2542, "w": 1052, "h": 65}, "text": "errare, sed rectè, & iustè iudicare, quia"}, "40": {"bbox": {"x": 16, "y": 2607, "w": 1047, "h": 71}, "text": "iusta sententia verè, & coram Deo, &"}, "41": {"bbox": {"x": 20, "y": 2678, "w": 1039, "h": 62}, "text": "hominibus non est, quae in se est vera"}, "42": {"bbox": {"x": 16, "y": 2738, "w": 1045, "h": 67}, "text": "hominis illius iudicis, sed quae secundum"}, "43": {"bbox": {"x": 13, "y": 2808, "w": 1048, "h": 62}, "text": "acta, & opinionem, & bonam fidem ibi"}, "44": {"bbox": {"x": 17, "y": 2872, "w": 1050, "h": 61}, "text": "iudicatur. Demum si quis non audiuit"}, "45": {"bbox": {"x": 16, "y": 2939, "w": 1039, "h": 59}, "text": "missam die Dominica existimans inuin¬"}, "46": {"bbox": {"x": 22, "y": 3003, "w": 1048, "h": 60}, "text": "cibiliter diem esse profestum, facit qui¬"}, "47": {"bbox": {"x": 20, "y": 3071, "w": 1046, "h": 62}, "text": "dem contra scientiam Dei scientis id"}, "48": {"bbox": {"x": 25, "y": 3134, "w": 1038, "h": 66}, "text": "esse ptohibitum, & errat, & facit contra"}, "49": {"bbox": {"x": 17, "y": 3200, "w": 1046, "h": 67}, "text": "id, quod ipsa res exigit, & conscientiam"}, "50": {"bbox": {"x": 17, "y": 3275, "w": 1046, "h": 54}, "text": "habet erroneam, sed verè, & realiter non"}, "51": {"bbox": {"x": 29, "y": 3338, "w": 1032, "h": 75}, "text": "peccat, quia peccatum non regulatur"}, "52": {"bbox": {"x": 32, "y": 3401, "w": 1030, "h": 78}, "text": "per veram scientiam Dei, sed per con¬"}, "53": {"bbox": {"x": 20, "y": 3470, "w": 1043, "h": 61}, "text": "scientiam licet erroneam missam non"}, "54": {"bbox": {"x": 20, "y": 3535, "w": 1037, "h": 70}, "text": "audietis, ad quam dicit in ratione pec¬"}, "55": {"bbox": {"x": 22, "y": 3600, "w": 684, "h": 65}, "text": "cati essentialem ordinem."}, "56": {"bbox": {"x": 81, "y": 3667, "w": 978, "h": 82}, "text": "Ad primum ergo concedimus iusti¬"}, "57": {"bbox": {"x": 26, "y": 3741, "w": 1035, "h": 55}, "text": "tiam consistere in ęqualitate pretij cum"}, "58": {"bbox": {"x": 29, "y": 3800, "w": 1030, "h": 62}, "text": "valore rei, sed addimus valorem illum"}, "59": {"bbox": {"x": 22, "y": 3871, "w": 1025, "h": 62}, "text": "rei esse diuisibilem iuxta ęstimationem,"}, "60": {"bbox": {"x": 28, "y": 3941, "w": 90, "h": 64}, "text": "vel opiniones hominum, vnde sumitur."}}}