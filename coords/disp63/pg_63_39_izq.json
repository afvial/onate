{"img_w": 1062, "img_h": 4017, "img_name": "facsimiles/disp63/pg_63_39_izq.png", "lines": {"1": {"bbox": {"x": 16, "y": 0, "w": 1013, "h": 64}, "text": "sunt, sed aequalitas consistit in indivisi¬"}, "2": {"bbox": {"x": 12, "y": 66, "w": 1018, "h": 65}, "text": "bili. Secundo, quia secundum Arist."}, "3": {"bbox": {"x": 14, "y": 135, "w": 1015, "h": 66}, "text": "iustitia distributiua consistit in aequalita"}, "4": {"bbox": {"x": 6, "y": 203, "w": 1012, "h": 54}, "text": "te Geometrica, at iustitia commutati¬"}, "5": {"bbox": {"x": 5, "y": 270, "w": 1022, "h": 60}, "text": "ua consistit inaequalitate Arithmetica; sed"}, "6": {"bbox": {"x": 8, "y": 336, "w": 1022, "h": 69}, "text": "aequalitas arithmetica est indiuisibilis,"}, "7": {"bbox": {"x": 12, "y": 403, "w": 1011, "h": 62}, "text": "ergò. Tertio exemplis sicut aestimatio"}, "8": {"bbox": {"x": 6, "y": 470, "w": 1010, "h": 79}, "text": "numeri grannorum arenae maris, Ange¬"}, "9": {"bbox": {"x": 5, "y": 538, "w": 1020, "h": 58}, "text": "lorum, hominum saluandorum, vel di¬"}, "10": {"bbox": {"x": 6, "y": 612, "w": 1025, "h": 57}, "text": "stantia orbis occidentalis ab orientali, vel"}, "11": {"bbox": {"x": 10, "y": 671, "w": 1019, "h": 64}, "text": "terrę abempyreo coelo est quidem in"}, "12": {"bbox": {"x": 5, "y": 736, "w": 1022, "h": 60}, "text": "se, & Deo indiuisibilis; nobis autem i¬"}, "13": {"bbox": {"x": 12, "y": 805, "w": 1011, "h": 73}, "text": "gnota, & propter ignorantiam diuisibilis,"}, "14": {"bbox": {"x": 14, "y": 873, "w": 1019, "h": 60}, "text": "& hanc sententiam probabilem reputat"}, "15": {"bbox": {"x": 12, "y": 942, "w": 756, "h": 59}, "text": "Salas de emption. dub. 4.num 5."}, "16": {"bbox": {"x": 66, "y": 1014, "w": 960, "h": 60}, "text": "Secunda sententia communis est etiam,"}, "17": {"bbox": {"x": 10, "y": 1075, "w": 1019, "h": 59}, "text": "in se, & coram Deo aestimationem, &"}, "18": {"bbox": {"x": 23, "y": 1143, "w": 1006, "h": 77}, "text": "pretium rerum venalium esse diuisibilem,"}, "19": {"bbox": {"x": 17, "y": 1207, "w": 999, "h": 79}, "text": "& habere latitudinem. Ita vt Reges le¬"}, "20": {"bbox": {"x": 17, "y": 1277, "w": 990, "h": 71}, "text": "gale pretium taxantes, & in rem pu¬"}, "21": {"bbox": {"x": 21, "y": 1343, "w": 1001, "h": 61}, "text": "blicam consuetudinarium pretium in¬"}, "22": {"bbox": {"x": 23, "y": 1412, "w": 993, "h": 53}, "text": "ducentes, & pretio conuentionali in¬"}, "23": {"bbox": {"x": 23, "y": 1477, "w": 1006, "h": 58}, "text": "terse contrahentes, omni ignorantia"}, "24": {"bbox": {"x": 30, "y": 1544, "w": 999, "h": 57}, "text": "exclusa, & omnes circumstantias rei ven"}, "25": {"bbox": {"x": 27, "y": 1607, "w": 995, "h": 63}, "text": "ditae, & pretij comprehendents etiam"}, "26": {"bbox": {"x": 23, "y": 1674, "w": 1002, "h": 53}, "text": "tunc latitudine vti possit. Ita Molin.di¬"}, "27": {"bbox": {"x": 17, "y": 1740, "w": 1014, "h": 80}, "text": "seut. 347. Salon. 2. 2. q. 77. art. 1. controuers."}, "28": {"bbox": {"x": 21, "y": 1809, "w": 1013, "h": 72}, "text": "3. conclus. 2. Rebel. 2. p. lib. 8. q. 2. n. Salas"}, "29": {"bbox": {"x": 17, "y": 1873, "w": 1019, "h": 63}, "text": "de empt. dub. 4.n. 8. Conrad. q. 56. concl. 1."}, "30": {"bbox": {"x": 16, "y": 1940, "w": 1020, "h": 64}, "text": "Probatur hęc sententia, quia valor non est"}, "31": {"bbox": {"x": 16, "y": 2012, "w": 1024, "h": 60}, "text": "aliquid intrinsecum, & reale in rebus vena"}, "32": {"bbox": {"x": 14, "y": 2078, "w": 1022, "h": 58}, "text": "libus, sed ęstimatio ipsa hominum attentis"}, "33": {"bbox": {"x": 12, "y": 2140, "w": 1031, "h": 60}, "text": "omnibus circunstantijs, quae iusta ratione"}, "34": {"bbox": {"x": 6, "y": 2208, "w": 1038, "h": 58}, "text": "attendi debent, & ex comparatione rei ad"}, "35": {"bbox": {"x": 17, "y": 2274, "w": 1019, "h": 75}, "text": "pretium resultans. Sed haec aestimatio lati¬"}, "36": {"bbox": {"x": 10, "y": 2343, "w": 1026, "h": 58}, "text": "tudinem habet etiam coram Deo id est"}, "37": {"bbox": {"x": 3, "y": 2407, "w": 1037, "h": 58}, "text": "Deus illam videt, & cognòscit, ergo"}, "38": {"bbox": {"x": 23, "y": 2472, "w": 1020, "h": 75}, "text": "pretium iustum rerum etiam respectu"}, "39": {"bbox": {"x": 5, "y": 2540, "w": 1031, "h": 60}, "text": "Dei iure ipso naturali habet latitudinem."}, "40": {"bbox": {"x": 6, "y": 2603, "w": 1033, "h": 70}, "text": "Secundo, quia alias pretium iustum,"}, "41": {"bbox": {"x": 8, "y": 2674, "w": 1031, "h": 77}, "text": "quod in omnibus contractibus attingi¬"}, "42": {"bbox": {"x": 5, "y": 2734, "w": 1025, "h": 88}, "text": "mus, etiam ipsum legale, solum per ac¬"}, "43": {"bbox": {"x": 3, "y": 2800, "w": 1031, "h": 53}, "text": "cidens esset iustum. Tertiò, quia seque¬"}, "44": {"bbox": {"x": 4, "y": 2866, "w": 1026, "h": 63}, "text": "retur eos etiam qui iustè contrahunt."}, "45": {"bbox": {"x": 5, "y": 2939, "w": 1040, "h": 60}, "text": "iuxta quodcumque pretium, siue legale,"}, "46": {"bbox": {"x": 8, "y": 2996, "w": 1035, "h": 56}, "text": "siue consuetudinarium, siue conuentio¬"}, "47": {"bbox": {"x": 12, "y": 3069, "w": 1033, "h": 57}, "text": "nale, si post contractum iustè peractum"}, "48": {"bbox": {"x": 8, "y": 3127, "w": 1041, "h": 61}, "text": "melius callerent, & perspicerent circun¬"}, "49": {"bbox": {"x": 10, "y": 3192, "w": 1020, "h": 80}, "text": "stantias pretij taxati à Rege, vel lege"}, "50": {"bbox": {"x": 16, "y": 3256, "w": 1020, "h": 61}, "text": "vel consuetudine teneri ad rescinden¬"}, "51": {"bbox": {"x": 14, "y": 3325, "w": 1034, "h": 63}, "text": "dos contractus iustè peractos, si postea"}, "52": {"bbox": {"x": 10, "y": 3391, "w": 1034, "h": 81}, "text": "melius callerent, & perspicerent circun¬"}, "53": {"bbox": {"x": 14, "y": 3460, "w": 1026, "h": 60}, "text": "stantias pretij iusti, vel ad restitutionem"}, "54": {"bbox": {"x": 21, "y": 3527, "w": 1009, "h": 78}, "text": "excessus, cùm iam expulerint ignoran¬"}, "55": {"bbox": {"x": 17, "y": 3595, "w": 1022, "h": 78}, "text": "tiam, propter quam vnum prerium il¬"}, "56": {"bbox": {"x": 21, "y": 3662, "w": 1027, "h": 60}, "text": "lud erat iustum. Quintò, quia si iustum"}, "57": {"bbox": {"x": 31, "y": 3730, "w": 1005, "h": 68}, "text": "pretium sumendum esset ex naturali va¬"}, "58": {"bbox": {"x": 23, "y": 3792, "w": 1016, "h": 67}, "text": "lore rerum, vel vsus: certè res natura"}, "59": {"bbox": {"x": 19, "y": 3862, "w": 1019, "h": 67}, "text": "sua magis nobiles essent maioris pretij,"}, "60": {"bbox": {"x": 31, "y": 3927, "w": 279, "h": 73}, "text": "v.g. culia, vel mus, quam aurum; &"}}}