tok:s_p35izq_3
    a nif:Sentence ;
    nif:anchorOf "Sed in alia significatione magis stricta pretium sumitur in hac materia emptionis, et venditionis, dum definimus eam esse permutationem rei pro pretio; pretium enim ibi accipitur pro pecunia, quae est mensura rerum venalium, quae commutari debent, ut fiat permutatio secundum iustitiam, et adaequalitatem."@la ;
    dct:isPartOf tok:p35izq ;
    onate:n 3 ;
    nif:firstWord tok:s_p35izq_3_t1 .

