tok:s_p39izq_11
    a nif:Sentence ;
    nif:anchorOf "Quintò, quia si iustum pretium sumendum esset ex naturali valore rerum, vel vsus: certè res natura sua magis nobiles essent maioris pretij, v. g. culia, vel mus, quam aurum; et vermis, quam gemma, et similiter, vsus magis necessarios, et vtiles habentes, quam quae non sunt necessariae, vel vtiles; vnde vnicus panis multis gemmis, et falconibus esset praeponendus, et pretiosior, quod nemo sani capitis dixerit."@la ;
    dct:isPartOf tok:p39izq ;
    dct:isPartOf tok:p39der ;
    onate:n 11 ;
    onate:continuedIn tok:s_p39der_1 ;
    nif:firstWord tok:s_p39izq_11_t1 .

tok:s_p39izq_11_t1
