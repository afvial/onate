tok:s_p39izq_10
    a nif:Sentence ;
    nif:anchorOf "Tertiò, quia sequeretur eos etiam qui iustè contrahunt. iuxta quodcumque pretium, siue legale, siue consuetudinarium, siue conuentionale, si post contractum iustè peractum melius callerent, et perspicerent circunstantias pretij taxati à Rege, vel lege vel consuetudine teneri ad rescindendos contractus iustè peractos, si postea melius callerent, et perspicerent circunstantias pretij iusti, vel ad restitutionem excessus, cùm iam expulerint ignorantiam, propter quam vnum prerium illud erat iustum."@la ;
    dct:isPartOf tok:p39izq ;
    onate:n 10 ;
    nif:firstWord tok:s_p39izq_10_t1 .

