tok:s_p34der_8
    a nif:Sentence ;
    nif:anchorOf "Ita iustitia vniuersalis, quae omnem virtutem complectitur consistit in vera earum aestimatione, qua vnamquamque rerum omnium vera trutina, et aequa lance pensitantes, nec magis, nec minus aestimamus, sed aequaliter ad amussim, ac ut recta ratio exigit ei praeponentes quae praeferenda secundum rectam rationem sunt, et postponentes quae postponenda sunt, et aequantes, quae sunt coaequanda."@la ;
    dct:isPartOf tok:p34der ;
    onate:n 8 ;
    nif:firstWord tok:s_p34der_8_t1 .

