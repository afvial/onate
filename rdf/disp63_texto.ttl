tok:s_p38der_6
    a nif:Sentence ;
    nif:anchorOf "Sicut quando aestimamus Roma, v. g. vel ipse sol quot ab hinc leucis distet planum est distantiam illam esse in se, et coram Deo definitam, et indiuisibilem, tamen nos quia ignoramus, iusta probabilitate in varias opiniones abimus, quod in re praesenti magis locum habet, cum taxatio pretij, ex quam plurimis circunstantijs nobis occultissimis, et collatione earum cum alijs, et cum pretio debeat pensitari."@la ;
    dct:isPartOf tok:p38der ;
    onate:n 6 ;
    nif:firstWord tok:s_p38der_6_t1 .

