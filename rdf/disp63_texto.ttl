tok:s_p33unica_1
    a nif:Sentence ;
    nif:anchorOf "MATERIAM huius contractus esse diximus ex parte vendentis rem vendibilem, seu mercem, cuius dominium in emptorem transfert; ex parte verò emptoris pretium mercis, cuius dominium pariter in venditorem transfundit: diximus de merce, seu re vendibili, dicamus modo de pretio; quia tota huius contractus iustitia consistit in pretio cum merce coaequando."@la ;
    dct:isPartOf tok:p33unica ;
    onate:n 1 ;
    nif:firstWord tok:s_p33unica_1_t1 .

