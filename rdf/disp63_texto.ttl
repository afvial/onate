tok:s_p41izq_6
    a nif:Sentence ;
    nif:anchorOf "Quartò, quis sanae mentis credat pro oue, v. g. vel passere vendito iustitia illaesa posse mille aureos in pretium accipere venditorem, vel pro lente potuisse accipere Iacob patrimonium Esau, nisi Dominus omnium ei illud patrimonium donare voluisset auferens ab iniusto possessore, et transferens ad sanctissimum Patriarcham?"@la ;
    dct:isPartOf tok:p41izq ;
    onate:n 6 ;
